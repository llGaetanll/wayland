/*

!.gitignore
!NOTES.md

# Local
 
# Config
!.config
.config/*

!.config/hypr/
.config/hypr/wallpapers/

!.config/waybar/

!.config/rofi/

!.config/eww/

# Firefox: track only our userChrome + user.js, not the rest of the dir.
# (Re-include each parent dir, ignore its contents, then re-include the file.)
!.config/firefox/
.config/firefox/*
!.config/firefox/user.js
!.config/firefox/chrome/
.config/firefox/chrome/*
!.config/firefox/chrome/userChrome.css

# GTK3 (Nemo styling): track only our css + settings, not bookmarks/caches.
!.config/gtk-3.0/
.config/gtk-3.0/*
!.config/gtk-3.0/gtk.css
!.config/gtk-3.0/settings.ini

# Misc
!.zprofile
