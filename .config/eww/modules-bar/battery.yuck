;; The Battery panel, behind the bar's pill. Published by module-battery off one
;; read of /sys/class/power_supply/BAT0/uevent, so the percentage, current and
;; charge cannot come from three different instants; `batt` arrives as one object
;; for the same reason.
;;
;; The process list is the one estimate here: intel-rapl's energy_uj is root-only,
;; so the share is CPU time over a measured window, grouped by process group. The
;; ordering is real, which is why no per-app wattage is published.
(defvar batt '{"percent":0,"charging":false,"source":"Battery",
               "time_label":"Time remaining","time":"—",
               "watts":"0.0 W","health":"Unknown","cycles":0}')

;; The chart is an SVG the daemon regenerates, exactly like the bar's pill —
;; GTK3 CSS cannot draw a chart, and eww's own `graph` widget only plots a value
;; forward from the daemon's own uptime, so it cannot show the twelve hours that
;; happened before the panel opened. The ring lives on disk, which is what lets
;; the chart survive a daemon restart, and the path carries a fingerprint of the
;; points so the background-image reloads when the picture moves.
(defvar batt_graph "")
(defvar batt_range "Last 12 Hours")

;; Ordered by share, descending, top few only. `share` and `uptime` arrive as
;; the finished strings: eww's expression language has no division that rounds
;; the way a person reads a clock, and a duration split across two yuck
;; expressions would be the same rule written twice.
(defvar batt_procs "[]")

(defwidget battery-panel []
  (box :class "menu batt-menu ${theme}" :orientation "vertical" :space-evenly false
    ;; The same 42pt head every other panel uses.
    (box :class "menu-head" :space-evenly false :valign "center"
      (label :class "menu-title" :text "Battery" :halign "start" :hexpand true)
      (label :class "batt-big" :text "${batt.percent}%" :halign "end"))

    ;; The label changes with the cable ("Time remaining" / "Time until full"),
    ;; so it comes from the daemon rather than being written here.
    (box :class "batt-lines" :orientation "vertical" :space-evenly false
      ;; The estimate leads; source and draw are the context qualifying it.
      (box :space-evenly false
        (label :class "batt-key" :text {batt.time_label} :halign "start" :hexpand true)
        (label :class "batt-val strong" :text {batt.time} :halign "end"))
      (box :space-evenly false
        (label :class "batt-key" :text "Power Source" :halign "start" :hexpand true)
        (label :class "batt-val" :text {batt.source} :halign "end"))
      (box :space-evenly false
        (label :class "batt-key" :text "Drawing" :halign "start" :hexpand true)
        (label :class "batt-val" :text {batt.watts} :halign "end")))

    (box :class "sep")

    ;; Fixed height, width from the panel's content box; the SVG is authored at
    ;; exactly that size so nothing is scaled.
    (label :class "menu-section" :text batt_range :halign "start")
    (box :class "batt-graph" :halign "fill"
         :style "background-image: url('${batt_graph}');")
    ;; No axis: the section label says the span and the right edge is always now.

    (box :class "sep")

    ;; Same row grammar as the Wi-Fi and Sound lists, with the app's own icon on
    ;; the 23pt those panels give their circle. The share is a number, not a bar:
    ;; at 3% a bar's rounded ends met and the row read as broken rather than low.
    (label :class "menu-section" :text "Using Significant Energy" :halign "start")
    (box :orientation "vertical" :space-evenly false
      (for p in batt_procs
        ;; A box, not a button: there is nothing to click. macOS offers no kill
        ;; here, and neither should a panel with no confirmation.
        (box :class "row batt-row" :space-evenly false :spacing 9 :valign "center"
          (box :class "batt-app-icon" :valign "center" :halign "center"
               :style "background-image: url('${p.icon}');")
          (label :class "row-name" :text {p.name} :halign "start" :hexpand true
                 :limit-width 18 :show-truncated true)
          ;; Uptime this boot, the qualifier the share needs: 38% over six hours
          ;; and 38% in ten minutes are not the same app to close.
          ;; Each column is a fixed-width box with the label pushed to its end,
          ;; not a label carrying the width: a GtkLabel wider than its text
          ;; centres it, and eww's label exposes no xalign to say otherwise.
          (box :class "batt-uptime-col" :halign "end"
            (label :class "batt-uptime" :text {p.uptime} :halign "end"))
          (box :class "batt-share-col" :halign "end"
            (label :class "batt-share" :text {p.share} :halign "end")))))

    ;; The footer macOS has, minus the link: there is no Settings app to open.
    (box :class "sep")
    ;; Two labels with a gap, not one string: a middot made them read as one phrase.
    (box :class "batt-foot" :space-evenly false :spacing 14
      (label :class "batt-key" :text "Condition" :halign "start" :hexpand true)
      (label :class "batt-val" :text {batt.health} :halign "end")
      (label :class "batt-val" :text "${batt.cycles} cycles" :halign "end"))))

(defwindow battery-menu
  ;; Same 373px and the same top-right anchor as the Sound and Wi-Fi panels.
  :monitor 0 :geometry (geometry :anchor "top right" :x "10px" :y "5px" :width "373px")
  :stacking "overlay" :focusable false
  (battery-panel))
