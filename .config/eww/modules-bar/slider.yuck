;; macOS's Sound and Display panels: a pill track whose filled part is WHITE with
;; the glyph knocked out of it, and a round white knob — not an accent bar.
;; Measured off control-center/sound-panel.png: 22pt track, 22pt knob.
;;
;; The daemon shows the requested value immediately and lets the probe confirm it
;; later, so a poll in flight cannot snap the knob back mid-drag.
(defvar vol_pct "0")
(defvar bri_pct "0")

;; The glyph sits on the white fill, so it is the dark ink in BOTH appearances —
;; the daemon's path follows the theme and would be white on white in dark mode.
;; The light set is the dark-ink set, so the path is rewritten in place.
(defwidget slider-panel [title icon value onchange]
  (box :class "menu ${theme}" :orientation "vertical" :space-evenly false
    (box :class "islider-head" :valign "center"
      (label :class "menu-title" :text title :halign "start" :hexpand true))
    (box :class "islider ${theme}"
      (overlay
        ;; :timeout must beat eww's 200ms default, or a slow set is SIGKILLed
        ;; mid-write. :max 101, not 100: eww builds every scale on a GtkAdjustment
        ;; with page_size 1 and :max only sets `upper`, while GTK caps a value at
        ;; `upper - page_size` — so 100 left the last percent undraggable. The
        ;; daemon clamps to 100 either way.
        (scale :class "islider-input" :hexpand true :value value :min 0 :max 101
               :round-digits 0 :timeout "2s" :onchange onchange)
        (box :class "islider-track" :valign "center")
        (box :class "islider-fill" :halign "start" :valign "center"
             :style "min-width: ${27.5 + value * 3.1}px;")
        ;; The fraction of the 248pt travel (270pt of track less the 22pt knob),
        ;; in px. The panel is a fixed 298pt wide, so this is arithmetic.
        (box :class "islider-knob" :halign "start" :valign "center"
             :style "margin-left: ${value * 3.1}px;")
        (box :class "islider-icon" :halign "start" :valign "center"
             :style "background-image: url('${replace(icon, "/dark/", "/light/")}');")))
    ;; The Volume panel's output list; Display passes nothing.
    (children)))

;; The Sound panel's output list. eww-state lists the sinks only while this panel
;; is open — the listing is the expensive half of that module.
;;
;; Per entry: `id_b64` is the sink to switch to, encoded because the name comes
;; off the hardware and reaches the handler inside a shell command; `name` is
;; node.nick rather than the codec's full string; `icon` is already the right
;; glyph for the row's state. Sinks whose port reads "not available" are omitted,
;; which is what keeps this machine's five permanent HDMI sinks out of the panel.
(defvar vol_outputs "[]")

;; Same row grammar as the Wi-Fi and Bluetooth lists. No scroll: a machine has a
;; handful of sinks, so the list is its own height and the panel grows with it.
(defwidget vol-outputs []
  (box :orientation "vertical" :space-evenly false
       :visible {arraylength(vol_outputs) > 0}
    (box :class "sep out-sep")
    (label :class "menu-section" :text "Output" :halign "start")
    (box :orientation "vertical" :space-evenly false
      (for o in vol_outputs
        ;; Leaves the menu open, like Bluetooth and unlike Wi-Fi: the tick
        ;; moving to the pressed row is the confirmation.
        (button :class "row" :onclick "eww-state volume output ${o.id_b64}"
          (box :space-evenly false :spacing 8 :valign "center"
            (box :class "row-mark disc ${o.active ? 'on' : 'off'}" :valign "center"
                 :halign "center"
              (box :class "row-glyph" :halign "center" :valign "center"
                   :style "background-image: url('${o.icon}');"))
            (label :class "row-name" :text {o.name} :halign "start" :hexpand true
                   :limit-width 26 :show-truncated true)))))))

(defwidget vol-slider []
  (slider-panel :title "Volume" :icon vol_icon :value vol_pct
                :onchange "eww-state volume set {}"
    (vol-outputs)))

(defwidget bri-slider []
  (slider-panel :title "Display" :icon bri_icon :value bri_pct
                :onchange "eww-state brightness set {}"))

(defwindow volume-menu
  ;; 8 / 4 / 298 pt x 1.25, the same width as the Wi-Fi and Bluetooth panels.
  :monitor 0 :geometry (geometry :anchor "top right" :x "10px" :y "5px" :width "373px")
  :stacking "overlay" :focusable false
  (vol-slider))

(defwindow brightness-menu
  ;; 8 / 4 / 298 pt x 1.25
  :monitor 0 :geometry (geometry :anchor "top right" :x "10px" :y "5px" :width "373px")
  :stacking "overlay" :focusable false
  (bri-slider))
