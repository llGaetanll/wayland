;; Each status var is the icon path for the current state, shown via
;; background-image so it reloads when the path changes. The battery pill is an
;; SVG the daemon regenerates, with the capacity baked into the filename.
(defvar vol_icon "")
(defvar bri_icon "")
(defvar net_icon "")
(defvar bt_icon "")
(defvar batt_icon "")
(defvar batt_pct 0)

;; :spacing 0 is deliberate — the gap is .sicon's padding, so it sits inside each
;; button and stays clickable rather than being a dead zone.
(defwidget statusicons []
  (box :class "status" :space-evenly false :valign "center" :spacing 0
    ;; macOS order: speaker, Bluetooth, battery, Wi-Fi, clock. Brightness has no
    ;; menu bar item there at all, so it goes to the far left, out of the way.
    (button :class "sicon" :onclick "eww-state menu toggle brightness"
      (box :class "status-icon" :style "background-image: url('${bri_icon}');"))
    (button :class "sicon" :onclick "eww-state menu toggle volume"
      (box :class "status-icon" :style "background-image: url('${vol_icon}');"))
    (button :class "sicon" :onclick "eww-state menu toggle bt"
      (box :class "status-icon" :style "background-image: url('${bt_icon}');"))
    ;; valign center, or GTK gives the box the whole 16px row height and
    ;; `background-size: contain` scales the 25.5x12 glyph 4pt too wide.
    ;; Two boxes because GTK paints a background across the padding box: the
    ;; outer carries the run's spacing, the inner is exactly the glyph. That
    ;; padding stays on .batt-slot, where it is measured against the glyph;
    ;; the button is transparent and only carries the click.
    (button :class "batt-btn" :onclick "eww-state menu toggle battery"
      (box :class "batt-slot" :valign "center" :space-evenly false :spacing 0
        (label :class "batt-pct" :valign "center" :text "${batt_pct}%")
        (box :class "batt-icon" :valign "center"
             :style "background-image: url('${batt_icon}');")))
    (button :class "sicon" :onclick "eww-state menu toggle wifi"
      (box :class "status-icon" :style "background-image: url('${net_icon}');"))))

(defwidget bar []
  (centerbox :class "bar ${theme}"
    (box)                                   ;; left  — reserved for the app menu
    (box)                                   ;; center
    (box :halign "end" :space-evenly false :spacing 0
      (statusicons)
      (label :class "bar-clock" :text clock))))

;; :exclusive true reserves the strip so windows sit below the bar, not under it.
;; Whether it shows at all is the daemon's call: it hides bar and dock together
;; on a fullscreen Space.
(defwindow bar
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "100%"
                      :height "30px" :anchor "top center")   ;; 24pt x 1.25
  :stacking "overlay"
  :exclusive true
  :focusable false
  ;; See the dock: its own namespace so the slide rule can name it.
  :namespace "eww-bar"
  (bar))

