;; Which bar dropdown is open ("" = none). The daemon holds it as a single
;; Option<MenuId>, so "two menus open at once" is not a value that exists. The
;; screenshot preview is deliberately outside this group.
(defvar menu "")

;; Full-screen click-catcher shared by every menu: eww windows don't close on
;; focus loss. A button, not an eventbox — clicks fall through an eventbox, which
;; has no solid input region. The distinct :namespace keeps the Hyprland blur rule
;; off this surface; blurring a full-screen one every frame near-locks the machine.
(defwindow menu-backdrop
  :monitor 0
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  :stacking "overlay"
  :focusable false
  :namespace "eww-backdrop"
  (button :class "backdrop" :onclick "eww-state menu close"
          :hexpand true :vexpand true))
