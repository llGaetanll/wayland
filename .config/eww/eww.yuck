;; Follow the system light/dark preference, applied as a CSS class so eww.scss
;; can style each theme.
(defpoll theme :interval "5s" :initial "light"
  `gsettings get org.gnome.desktop.interface color-scheme | grep -qi dark && echo dark || echo light`)

;; Apps and order come from dock.sh. Swaps push updates live via
;; `eww update dock_apps=...`, so the 1h interval is just a lazy resync.
(defpoll dock_apps :interval "3600s"
  :initial `~/.config/eww/scripts/dock.sh list`
  `~/.config/eww/scripts/dock.sh list`)

;; One dock slot: the eventbox makes it both draggable and a drop target, so
;; dropping app {} here swaps the two in the order file. A plain click falls
;; through to the button.
(defwidget applaunch [id icon cmd]
  (eventbox :class "dock-slot" :dragvalue id :dragtype "values"
            :ondropped "setsid -f ~/.config/eww/scripts/dock.sh swap {} ${id}"
    ;; `setsid -f` rather than a bare `&`: eww SIGKILLs a widget's command once
    ;; :timeout (default 200ms) expires, taking a merely-backgrounded child with it.
    (button :class "dock-btn"
            :onclick "setsid -f sh -c 'cd ~ && ${cmd}'"
      ;; Fixed-size cell with the icon centered, so hover growth happens in place
      ;; and neighbours never move. The icon is a background-image so the grow is
      ;; animated in CSS with no per-hover subprocess.
      (box :class "dock-cell" :halign "center" :valign "center"
        (box :class "dock-icon" :halign "center" :valign "center"
             :style "background-image: url('${icon}');")))))

(defwidget dock []
  (box :class "dock ${theme}" :space-evenly false :valign "center" :spacing 2
    (for a in {dock_apps}
      (applaunch :id {a.id} :cmd {a.cmd} :icon {a.icon}))))

(defwindow dock
  :monitor 0
  :geometry (geometry :y "0px" :anchor "bottom center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (dock))

(defpoll clock :interval "20s" `date '+%a %b %e  %H:%M'`)

;; Each status poll echoes the path of the icon matching the current state, shown
;; via background-image, so it reloads whenever the path changes. Volume and
;; brightness poll fast so keybind changes show up quickly.
(defpoll vol_icon  :interval "2s"  `~/.config/eww/scripts/status.sh volume`)
(defpoll bri_icon  :interval "3s"  `~/.config/eww/scripts/status.sh brightness`)
(defpoll net_icon  :interval "6s"  `~/.config/eww/scripts/status.sh network`)
(defpoll bt_icon   :interval "6s"  `~/.config/eww/scripts/status.sh bluetooth`)
(defpoll batt_icon :interval "15s" `~/.config/eww/scripts/battery.sh`)

;; :spacing 0 is deliberate — the gap comes from .sicon's padding instead, so it
;; sits inside each button and stays clickable rather than being a dead zone.
(defwidget statusicons []
  (box :class "status" :space-evenly false :valign "center" :spacing 0
    (button :class "sicon" :onclick "setsid -f ~/.config/eww/scripts/menu.sh toggle volume"
      (box :class "status-icon" :style "background-image: url('${vol_icon}');"))
    (button :class "sicon" :onclick "setsid -f ~/.config/eww/scripts/menu.sh toggle brightness"
      (box :class "status-icon" :style "background-image: url('${bri_icon}');"))
    (button :class "sicon" :onclick "setsid -f ~/.config/eww/scripts/menu.sh toggle wifi"
      (box :class "status-icon" :style "background-image: url('${net_icon}');"))
    (button :class "sicon" :onclick "setsid -f ~/.config/eww/scripts/menu.sh toggle bt"
      (box :class "status-icon" :style "background-image: url('${bt_icon}');"))
    (box :class "batt-icon" :style "background-image: url('${batt_icon}');")))

(defwidget bar []
  (centerbox :class "bar ${theme}"
    (box)                                   ;; left  — reserved for the app menu
    (box)                                   ;; center
    (box :halign "end" :space-evenly false :spacing 12
      (statusicons)
      (label :class "bar-clock" :text clock))))

;; Which bar dropdown is open ("" = none). Every such window is named
;; `<name>-menu` and they share the single `menu-backdrop` click-catcher.
;; menu.sh is the only thing allowed to write this var or open/close those
;; windows; see its header. The screenshot preview below is deliberately outside
;; this group — a Print press should not dismiss an open bar menu.
(defvar menu "")

;; The poll only runs while the menu is open.
(defpoll wifi :interval "5s" :run-while {menu == "wifi"}
  :initial `{"enabled":true,"networks":[],"list_h":40}`
  `~/.config/eww/scripts/wifi-list.sh`)

;; SSID currently being joined, so its row can show "Connecting…".
;; wifi-action.sh sets it before the blocking nmcli call.
(defvar wifi_connecting "")

(defwidget wifi-panel []
  (box :class "menu ${theme}" :orientation "vertical" :space-evenly false
    (box :class "menu-head" :space-evenly false :valign "center"
      (box :orientation "vertical" :space-evenly false :halign "start" :hexpand true
        (label :class "menu-title" :text "Wi-Fi" :halign "start")
        (label :class "menu-sub" :halign "start" :limit-width 26 :show-truncated true
               :text {wifi.enabled ? (wifi.connected != "" ? wifi.connected : "Not connected") : "Off"}))
      (button :class "sw-btn" :valign "center"
              :onclick "setsid -f ~/.config/eww/scripts/wifi-action.sh toggle"
        (box :class "sw ${wifi.enabled ? 'on' : 'off'}" :valign "center" :vexpand false
          (box :class "sw-knob" :valign "center" :halign {wifi.enabled ? "end" : "start"}))))
    (box :class "sep")
    ;; eventbox :cursor keeps the normal pointer during scroll; scroll and button
    ;; can't set one, and a bare scroll shows GTK's box-dot cursor.
    (scroll :class "menu-scroll" :vscroll true :height {wifi.list_h}
      (eventbox :cursor "default"
        (box :orientation "vertical" :space-evenly false :valign "start"
          (for n in {wifi.networks}
            (button :class "row" :onclick "setsid -f ~/.config/eww/scripts/wifi-action.sh connect ${n.ssid_b64}"
              (box :space-evenly false :spacing 8 :valign "center"
                (label :class "row-check" :text {n.active ? "✓" : ""})
                (label :class "row-name" :text {n.ssid} :halign "start" :hexpand true
                       :limit-width 24 :show-truncated true)
                (label :class "row-connecting" :text "Connecting…"
                       :visible {n.ssid == wifi_connecting})
                (box :class "row-icon" :style "background-image: url('${n.icon}');")))))))))

;; focusable false is required: focusable true grabs keyboard focus and breaks
;; the click-outside backdrop. The cost is no Esc dismiss, since eww's
;; onkeypressed needs focus; that would need a Hyprland keybind instead.
(defwindow wifi-menu
  :monitor 0
  :geometry (geometry :anchor "top right" :x "8px" :y "4px" :width "320px")
  :stacking "overlay"
  :focusable false
  (wifi-panel))

;; Full-screen click-catcher shared by every menu. eww windows don't close on
;; focus loss, so a click outside lands here and dismisses whatever `menu` names.
;; It's a button rather than a transparent eventbox because only a real widget
;; has a solid input region; clicks fall through an eventbox. The distinct
;; :namespace keeps the Hyprland blur rule off this surface — blurring a
;; full-screen one every frame near-locks the machine.
(defwindow menu-backdrop
  :monitor 0
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  :stacking "overlay"
  :focusable false
  :namespace "eww-backdrop"
  (button :class "backdrop" :onclick "setsid -f ~/.config/eww/scripts/menu.sh close"
          :hexpand true :vexpand true))

;; Same pattern as Wi-Fi. A device click toggles its connection and leaves the
;; menu open so the status updates in place.
(defpoll bt :interval "5s" :run-while {menu == "bt"}
  :initial `{"enabled":true,"devices":[],"list_h":40,"connected":""}`
  `~/.config/eww/scripts/bt-list.sh`)
(defvar bt_connecting "")

(defwidget bt-panel []
  (box :class "menu ${theme}" :orientation "vertical" :space-evenly false
    (box :class "menu-head" :space-evenly false :valign "center"
      (box :orientation "vertical" :space-evenly false :halign "start" :hexpand true
        (label :class "menu-title" :text "Bluetooth" :halign "start")
        (label :class "menu-sub" :halign "start" :limit-width 26 :show-truncated true
               :text {bt.enabled ? (bt.connected != "" ? bt.connected : "On") : "Off"}))
      (button :class "sw-btn" :valign "center"
              :onclick "setsid -f ~/.config/eww/scripts/bt-action.sh toggle"
        (box :class "sw ${bt.enabled ? 'on' : 'off'}" :valign "center" :vexpand false
          (box :class "sw-knob" :valign "center" :halign {bt.enabled ? "end" : "start"}))))
    (box :class "sep")
    (scroll :class "menu-scroll" :vscroll true :height {bt.list_h}
      (eventbox :cursor "default"
        (box :orientation "vertical" :space-evenly false :valign "start"
          (for d in {bt.devices}
            (button :class "row" :onclick "setsid -f ~/.config/eww/scripts/bt-action.sh connect ${d.mac_b64}"
              (box :space-evenly false :spacing 8 :valign "center"
                (label :class "row-check" :text {d.connected ? "✓" : ""})
                (label :class "row-name" :text {d.name} :halign "start" :hexpand true
                       :limit-width 26 :show-truncated true)
                (label :class "row-connecting" :text "Connecting…"
                       :visible {d.mac == bt_connecting})))))))))

(defwindow bt-menu
  :monitor 0
  :geometry (geometry :anchor "top right" :x "8px" :y "4px" :width "320px")
  :stacking "overlay"
  :focusable false
  (bt-panel))

;; Bare iOS-style sliders with the icon overlaid at the left. Values poll only
;; while the popup is open.
(defpoll vol_pct :interval "2s" :run-while {menu == "volume"} :initial "0"
  `~/.config/eww/scripts/controls.sh get-volume`)
(defpoll bri_pct :interval "2s" :run-while {menu == "brightness"} :initial "0"
  `~/.config/eww/scripts/controls.sh get-brightness`)

;; The scale paints itself: trough = the shared background color, highlight =
;; accent up to the value, both clipped to the 12px radius so the fill stays
;; rounded at either end. Colors come from colors.scss. The icon is overlaid last
;; so it draws on top of the fill.
(defwidget vol-slider []
  (overlay :class "islider ${theme}"
    ;; Not detached, unlike every other handler here: a drag fires many times a
    ;; second and each must land in order, which `setsid -f` can't promise.
    ;; :timeout must beat eww's 200ms default, or a slow set is SIGKILLed
    ;; mid-write and the slider drifts from the real volume.
    (scale :class "islider-input" :hexpand true :value vol_pct :min 0 :max 100 :round-digits 0
           :timeout "2s"
           :onchange "eww update vol_pct={} && ~/.config/eww/scripts/controls.sh set-volume {}")
    (box :class "islider-icon" :halign "start" :valign "center"
         :style "background-image: url('${vol_icon}');")))

(defwidget bri-slider []
  (overlay :class "islider ${theme}"
    (scale :class "islider-input" :hexpand true :value bri_pct :min 1 :max 100 :round-digits 0
           :timeout "2s"        ;; see the vol-slider note above
           :onchange "eww update bri_pct={} && ~/.config/eww/scripts/controls.sh set-brightness {}")
    (box :class "islider-icon" :halign "start" :valign "center"
         :style "background-image: url('${bri_icon}');")))

(defwindow volume-menu
  :monitor 0 :geometry (geometry :anchor "top right" :x "8px" :y "4px" :width "260px")
  :stacking "overlay" :focusable false
  (vol-slider))

(defwindow brightness-menu
  :monitor 0 :geometry (geometry :anchor "top right" :x "8px" :y "4px" :width "260px")
  :stacking "overlay" :focusable false
  (bri-slider))

;; screenshot.sh (bound to Print) captures a slurp region with grim, then opens
;; this menu with Copy / Save actions. Same pattern as the Wi-Fi and BT menus but
;; with its own open var and backdrop, outside the `menu` state machine, since a
;; keybind popup should neither close nor be closed by a bar dropdown. The shot is
;; a background-image box sized by the script to the captured aspect ratio, so it
;; clips to rounded corners without distorting.
(defvar shot_open false)
(defvar shot_path "")
(defvar shot_w 320)
(defvar shot_h 200)

(defwidget shot-panel []
  (box :class "menu shot ${theme}" :orientation "vertical" :space-evenly false :spacing 10
    (box :class "shot-preview" :halign "center"
         :style "background-image: url('${shot_path}'); min-width: ${shot_w}px; min-height: ${shot_h}px;")
    (box :class "shot-actions" :space-evenly true :spacing 8
      (button :class "shot-btn" :onclick "setsid -f ~/.config/eww/scripts/shot-action.sh copy"
        (label :text "Copy"))
      (button :class "shot-btn" :onclick "setsid -f ~/.config/eww/scripts/shot-action.sh save"
        (label :text "Save"))
      (button :class "shot-btn" :onclick "setsid -f ~/.config/eww/scripts/shot-action.sh discard"
        (label :text "Discard")))))

(defwindow shot-menu
  :monitor 0
  :geometry (geometry :anchor "top right" :x "8px" :y "4px")
  :stacking "overlay"
  :focusable false
  (shot-panel))

;; Its own click-catcher, not the shared `menu-backdrop`, so a click outside
;; dismisses only the shot and leaves any bar menu alone.
(defwindow shot-backdrop
  :monitor 0
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  :stacking "overlay"
  :focusable false
  :namespace "eww-backdrop"
  (button :class "backdrop" :onclick "setsid -f ~/.config/eww/scripts/shot-action.sh close"
          :hexpand true :vexpand true))

;; :exclusive true reserves the 24px strip so windows sit below the bar rather
;; than under it. Visibility itself is tracked by sync-bars.sh via
;; `eww active-windows`, not by this reserved area.
(defwindow bar
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "24px" :anchor "top center")
  :stacking "overlay"
  :exclusive true
  :focusable false
  (bar))
