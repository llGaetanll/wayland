;; Every variable below is pushed by `eww-state`, which owns all of this state
;; and is the only thing allowed to write them or to open and close these
;; windows. There is not a single defpoll left: what to sample and how often is
;; a rule, so it lives in the daemon's state machine (`eww-state polls` prints
;; the current plan). The initial values here are only what eww shows in the
;; instant before the daemon's first push lands.

;; Which fill of this table the daemon is looking at. The one var no widget
;; uses: `eww reload` re-reads this file and puts every defvar back at the
;; value written here, on the same process and the same socket, so nothing the
;; daemon can see about the connection says its variables are gone. It stamps a
;; number in here and reads it back — a table not carrying the current one is a
;; table it publishes again from scratch. Leave it empty: the daemon never
;; publishes a generation that reads as nothing.
(defvar eww_gen "")

(defvar theme "light")

(defvar clock "")

;; The dock's apps, in order, each with whether it currently has a window.
(defvar dock_apps "[]")

;; One dock slot: the eventbox makes it both draggable and a drop target, so
;; dropping app {} here swaps the two. A plain click falls through to the button.
(defwidget applaunch [id icon]
  (eventbox :class "dock-slot" :dragvalue id :dragtype "values"
            :ondropped "eww-state dock swap {} ${id}"
    ;; No `setsid -f` anywhere in this file any more. Every handler is one
    ;; connect-write-read on a unix socket and returns in well under eww's
    ;; 200ms :timeout, which is what used to truncate the shell handlers
    ;; mid-way and leave the state lying about what was on screen.
    (button :class "dock-btn" :onclick "eww-state dock launch ${id}"
      ;; Fixed-size cell with the icon centred, so nothing a tile does can
      ;; move its neighbours.
      (box :class "dock-cell" :halign "center" :valign "center"
        (box :class "dock-icon" :halign "center" :valign "center"
             :style "background-image: url('${icon}');")))))

;; The Trash is not in dock.conf: in macOS it is not a dock app you can reorder
;; or remove, it is a fixture at the end past the separator. Modelling it as one
;; would make it draggable and let the user drop another app onto it.
(defwidget trash []
  (button :class "dock-btn trash" :onclick "eww-state dock launch trash"
    (box :class "dock-cell" :halign "center" :valign "center"
      (box :class "dock-icon" :halign "center" :valign "center"
           :style "background-image: url('/home/al/.config/eww/icons/apps/trash.png');"))))

;; Windows put away in the dock. macOS keeps these past the separator, to the
;; right of every app and in the order they were minimized, and draws the window
;; itself rather than its app icon — the icon is badged on the corner so it is
;; still obvious what the tile belongs to. The daemon photographs a window on
;; its way out, which is the only moment there is anything left to photograph.
(defvar dock_minimized "[]")

(defwidget minimized [addr thumb icon title width]
  ;; The one window command that names a window: a minimized one is not the
  ;; focused window and, being off screen entirely, never can be.
  (button :class "dock-btn" :tooltip title
          :onclick "eww-state window restore ${addr}"
    ;; Sized by the daemon, not the stylesheet: a tile is as wide as the
    ;; window was, drawn at the tile height, and GTK sizes a box long before
    ;; it knows anything about the image about to be painted into it.
    (box :class "dock-cell" :halign "center" :valign "center"
         :style "min-width: ${width}px;"
      (box :class "dock-thumb" :halign "center" :valign "center"
           :style "background-image: url('${thumb}'); min-width: ${width}px;"
        (box :class "dock-badge" :halign "end" :valign "end"
             :style "background-image: url('${icon}');")))))

(defwidget dock []
  ;; The `for` lives in its own box on purpose. eww appends the widgets a `for`
  ;; produces to the parent AFTER the siblings written below it, so with the
  ;; loop as a direct child the Trash and the separator came out at the left-
  ;; hand end of the dock, in front of every app. Giving the loop a container of
  ;; its own makes this box's three children static, and static children keep
  ;; the order they are written in.
  (box :class "dock ${theme}" :space-evenly false :valign "center" :spacing 0
    (box :class "dock-apps" :space-evenly false :spacing 0
      (for a in {dock_apps}
        (applaunch :id {a.id} :icon {a.icon})))
    (box :class "dock-sep" :valign "center" :vexpand false)
    ;; Its own box for the same reason the app loop has one.
    (box :class "dock-minimized" :space-evenly false :spacing 0
      (for m in {dock_minimized}
        (minimized :addr {m.addr} :thumb {m.thumb} :icon {m.icon}
                   :title {m.title} :width {m.width})))
    (trash)))

(defwindow dock
  :monitor 0
  ;; 5pt of desktop below the slab, measured: the Dock's bottom edge is at
  ;; y=1075 on a 1080pt screen.
  ;; 5pt of desktop below the slab x 1.25 scale. eww resolves defwindow
  ;; geometry statically — a variable here is "Unknown variable" at open time —
  ;; so these are literals. KEEP IN SYNC with $ui-scale in metrics.scss.
  :geometry (geometry :y "6px" :anchor "bottom center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  ;; Its own namespace so the Hyprland slide rule can reach the dock without
  ;; also catching the menus, which share the default gtk-layer-shell one.
  ;; KEEP IN SYNC with the layer rules in ~/.config/hypr/hyprland.lua.
  :namespace "eww-dock"
  (dock))

;; Each status var is the path of the icon matching the current state, shown via
;; background-image, so it reloads whenever the path changes. The battery pill is
;; an SVG the daemon regenerates, with the capacity baked into its filename for
;; the same reason.
(defvar vol_icon "")
(defvar bri_icon "")
(defvar net_icon "")
(defvar bt_icon "")
(defvar batt_icon "")
(defvar batt_pct 0)

;; :spacing 0 is deliberate — the gap comes from .sicon's padding instead, so it
;; sits inside each button and stays clickable rather than being a dead zone.
(defwidget statusicons []
  (box :class "status" :space-evenly false :valign "center" :spacing 0
    ;; macOS orders its system items speaker, Bluetooth, battery, Wi-Fi, and
    ;; then the clock. Brightness has no menu bar item in macOS at all — it
    ;; lives in Control Center — so it goes to the far left, out of the way of
    ;; the run that has to read as the real thing.
    (button :class "sicon" :onclick "eww-state menu toggle brightness"
      (box :class "status-icon" :style "background-image: url('${bri_icon}');"))
    (button :class "sicon" :onclick "eww-state menu toggle volume"
      (box :class "status-icon" :style "background-image: url('${vol_icon}');"))
    (button :class "sicon" :onclick "eww-state menu toggle bt"
      (box :class "status-icon" :style "background-image: url('${bt_icon}');"))
    ;; valign center, or GTK gives this box the whole 16px row height and
    ;; `background-size: contain` then scales the 25.5x12 glyph up to fit it,
    ;; which comes out 4pt too wide.
    ;; Two boxes: the outer one carries the same padding as a .sicon so the
    ;; battery keeps the run's spacing, the inner one is exactly the glyph. GTK
    ;; paints a background across the padding box, so a single box would size
    ;; the glyph to the padded area and draw it several points too wide.
    (box :class "batt-slot" :valign "center" :space-evenly false :spacing 0
      (label :class "batt-pct" :valign "center" :text "${batt_pct}%")
      (box :class "batt-icon" :valign "center"
           :style "background-image: url('${batt_icon}');"))
    (button :class "sicon" :onclick "eww-state menu toggle wifi"
      (box :class "status-icon" :style "background-image: url('${net_icon}');"))))

(defwidget bar []
  (centerbox :class "bar ${theme}"
    (box)                                   ;; left  — reserved for the app menu
    (box)                                   ;; center
    (box :halign "end" :space-evenly false :spacing 0
      (statusicons)
      (label :class "bar-clock" :text clock))))

;; Which bar dropdown is open ("" = none). Only ever written by the daemon, whose
;; state machine holds it as a single Option<MenuId> — so "two menus open at
;; once" is not a value that exists. The screenshot preview below is deliberately
;; outside this group: a Print press should not dismiss an open bar menu.
(defvar menu "")

;; The daemon polls the network faster while this menu is open and slower when it
;; is not; the widget does not have to know that.
(defvar wifi '{"enabled":true,"subtitle":"","list_h":40,"networks":[]}')

;; SSID currently being joined, so its row can show "Connecting…".
(defvar wifi_connecting "")

(defwidget wifi-panel []
  (box :class "menu ${theme}" :orientation "vertical" :space-evenly false
    ;; Title and switch, nothing else. macOS carries no subtitle here: the
    ;; network in use is the one marked in the list, not a line under the title.
    (box :class "menu-head" :space-evenly false :valign "center"
      (label :class "menu-title" :text "Wi-Fi" :halign "start" :hexpand true)
      (button :class "sw-btn" :valign "center" :onclick "eww-state wifi toggle"
        (box :class "sw ${wifi.enabled ? 'on' : 'off'}" :valign "center" :vexpand false
          (box :class "sw-knob" :valign "center" :halign {wifi.enabled ? "end" : "start"}))))
    (box :class "sep")
    ;; The network in use, then everything else — the two sections macOS shows.
    ;; The daemon publishes them as separate arrays because a widget cannot
    ;; partition a list, and labelling one list "Known Network" was wrong about
    ;; every row but one.
    (label :class "menu-section" :text "Known Network" :halign "start"
           :visible {wifi.has_known})
    (box :orientation "vertical" :space-evenly false
      (for n in {wifi.known}
        (button :class "row" :onclick "eww-state wifi connect ${n.ssid_b64}"
          (box :space-evenly false :spacing 9 :valign "center"
            (box :class "row-mark on" :valign "center" :halign "center"
              (box :class "row-glyph" :halign "center" :valign "center"
                   :style "background-image: url('${n.icon_on}');"))
            (label :class "row-name" :text {n.ssid} :halign "start" :hexpand true
                   :limit-width 24 :show-truncated true)
            (box :class "row-lock" :valign "center" :visible {n.secure})))))
    (label :class "menu-section" :text "Other Networks" :halign "start")
    ;; eventbox :cursor keeps the normal pointer during scroll; scroll and button
    ;; can't set one, and a bare scroll shows GTK's box-dot cursor.
    (scroll :class "menu-scroll" :vscroll true :height {wifi.list_h}
      (eventbox :cursor "default"
        (box :orientation "vertical" :space-evenly false :valign "start"
          (for n in {wifi.networks}
            ;; Base64: nothing an access point can call itself is ever
            ;; interpreted, by a shell or by anything else.
            (button :class "row" :onclick "eww-state wifi connect ${n.ssid_b64}"
              (box :space-evenly false :spacing 8 :valign "center"
                ;; One leading icon column, as in Control Center. The network in
                ;; use fills the circle with the accent and switches to the white
                ;; glyph; the rest show the bare signal glyph.
                (box :class "row-mark ${n.active ? 'on' : 'off'}" :valign "center"
                     :halign "center"
                  (box :class "row-glyph" :halign "center" :valign "center"
                       :style "background-image: url('${n.active ? n.icon_on : n.icon}');"))
                (label :class "row-name" :text {n.ssid} :halign "start" :hexpand true
                       :limit-width 24 :show-truncated true)
                (label :class "row-connecting" :text "Connecting…"
                       :visible {n.ssid == wifi_connecting})
                ;; The padlock is a trailing item in macOS, at the right-hand
                ;; edge of the row, not a badge on the signal glyph: measured at
                ;; x 280..289 in a panel whose right edge is 305. Its image is
                ;; set in the stylesheet rather than by an inline :style — see
                ;; the note on .row-lock in eww.scss.
                (box :class "row-lock" :valign "center"
                     :visible {n.secure})))))))))

;; focusable false is required: focusable true grabs keyboard focus and breaks
;; the click-outside backdrop. The cost is no Esc dismiss, since eww's
;; onkeypressed needs focus; that would need a Hyprland keybind instead.
(defwindow wifi-menu
  :monitor 0
  ;; 8 / 4 / 298 pt x 1.25
  :geometry (geometry :anchor "top right" :x "10px" :y "5px" :width "373px")
  :stacking "overlay"
  :focusable false
  (wifi-panel))

;; Full-screen click-catcher shared by every menu. eww windows don't close on
;; focus loss, so a click outside lands here and dismisses whatever `menu` names.
;; It's a button rather than a transparent eventbox because only a real widget
;; has a solid input region; clicks fall through an eventbox. The distinct
;; :namespace keeps the Hyprland blur rule off this surface — blurring a
;; full-screen one every frame near-locks the machine.
(defwindow menu-backdrop
  :monitor 0
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  :stacking "overlay"
  :focusable false
  :namespace "eww-backdrop"
  (button :class "backdrop" :onclick "eww-state menu close"
          :hexpand true :vexpand true))

;; Same pattern as Wi-Fi. A device click toggles its connection and leaves the
;; menu open so the status updates in place — that difference is a rule in the
;; daemon, not something this file decides.
(defvar bt '{"enabled":true,"subtitle":"","list_h":40,"devices":[]}')
(defvar bt_connecting "")

(defwidget bt-panel []
  (box :class "menu ${theme}" :orientation "vertical" :space-evenly false
    (box :class "menu-head" :space-evenly false :valign "center"
      (label :class "menu-title" :text "Bluetooth" :halign "start" :hexpand true)
      (button :class "sw-btn" :valign "center" :onclick "eww-state bt toggle"
        (box :class "sw ${bt.enabled ? 'on' : 'off'}" :valign "center" :vexpand false
          (box :class "sw-knob" :valign "center" :halign {bt.enabled ? "end" : "start"}))))
    (box :class "sep")
    (label :class "menu-section" :text "Devices" :halign "start")
    (scroll :class "menu-scroll" :vscroll true :height {bt.list_h}
      (eventbox :cursor "default"
        (box :orientation "vertical" :space-evenly false :valign "start"
          (for d in {bt.devices}
            (button :class "row" :onclick "eww-state bt connect ${d.mac_b64}"
              (box :space-evenly false :spacing 8 :valign "center"
                ;; Same leading column as Wi-Fi. Every device shows the same
                ;; glyph for now; the per-kind icons macOS uses would need the
                ;; device class out of bluetoothctl, which the daemon does not
                ;; read yet.
                (box :class "row-mark disc ${d.connected ? 'on' : 'off'}" :valign "center"
                     :halign "center"
                  (box :class "row-glyph" :halign "center" :valign "center"
                       :style "background-image: url('${d.icon}');"))
                (label :class "row-name" :text {d.name} :halign "start" :hexpand true
                       :limit-width 26 :show-truncated true)
                (label :class "row-connecting" :text "Connecting…"
                       :visible {d.mac == bt_connecting})))))))))

(defwindow bt-menu
  :monitor 0
  ;; 8 / 4 / 298 pt x 1.25
  :geometry (geometry :anchor "top right" :x "10px" :y "5px" :width "373px")
  :stacking "overlay"
  :focusable false
  (bt-panel))

;; macOS's Sound and Display panels: a title, then a pill track whose filled
;; part is WHITE with the glyph knocked out of it in dark, and a round white
;; knob at the value. Not an accent-coloured bar — measured off
;; control-center/sound-panel.png, where the fill samples #ffffff, the unfilled
;; track #434344, and the track is 22pt tall with a 22pt knob.
;;
;; The daemon shows the requested value immediately and lets the probe confirm
;; it later, so a poll already in flight cannot snap the knob back mid-drag.
(defvar vol_pct "0")
(defvar bri_pct "0")

;; The glyph sits on the white fill, so it has to be the dark ink in BOTH
;; appearances — the daemon's own icon path follows the theme and would be white
;; on white in dark mode. The light set is exactly the dark-ink set, so the path
;; is rewritten rather than adding a second variable for it.
(defwidget slider-panel [title icon value onchange]
  (box :class "menu ${theme}" :orientation "vertical" :space-evenly false
    (box :class "islider-head" :valign "center"
      (label :class "menu-title" :text title :halign "start" :hexpand true))
    (box :class "islider ${theme}"
      (overlay
        ;; :timeout must beat eww's 200ms default, or a slow set is SIGKILLed
        ;; mid-write. It never gets close now — the handler is a socket write.
        ;; :max 101, not 100. eww builds every scale on a GtkAdjustment with a
        ;; page_size of 1 (widget_definitions.rs, `Adjustment::new(0, 0, 100, 1,
        ;; 1, 1)`) and :max only sets the adjustment's upper — and GTK caps a
        ;; value at `upper - page_size`. With :max 100 the last percent was
        ;; unreachable by dragging: the end of the track set 99, and the knob
        ;; stopped 3px short of the end. The daemon clamps to 100 either way.
        (scale :class "islider-input" :hexpand true :value value :min 0 :max 101
               :round-digits 0 :timeout "2s" :onchange onchange)
        (box :class "islider-track" :valign "center")
        (box :class "islider-fill" :halign "start" :valign "center"
             :style "min-width: ${27.5 + value * 3.1}px;")
        ;; The fraction of the 248pt travel (270pt of track less the 22pt
        ;; knob), in px — the 14pt inset is already on .islider. The panel is a
        ;; fixed 298pt wide, so this is arithmetic, not something GTK solves.
        (box :class "islider-knob" :halign "start" :valign "center"
             :style "margin-left: ${value * 3.1}px;")
        (box :class "islider-icon" :halign "start" :valign "center"
             :style "background-image: url('${replace(icon, "/dark/", "/light/")}');")))
    ;; Anything a caller hangs under the slider — the Volume panel's output
    ;; list. Display passes nothing and the panel is unchanged.
    (children)))

;; The Sound panel's output list — where sound is going, and the other places
;; it could go. `vol_outputs` is published by eww-state, which lists the sinks
;; only while this panel is open: off screen nothing shows them and the listing
;; is the expensive half of that module.
;;
;; Per entry: `id_b64` is the sink to switch to, encoded because a sink name
;; comes off the hardware and reaches the handler inside a shell command.
;; `name` is the device's own short name (node.nick — "Speaker", "HDMI 1" —
;; rather than the codec's "Core Ultra Processors (Series 3) HD Audio Speaker"),
;; and `icon` is already the right glyph for whether the row is the active one,
;; so this file never picks between two. A sink whose port reads "not available"
;; is not in the list at all: that is what keeps this machine's five permanent
;; HDMI sinks out of a panel where nothing is plugged in.
(defvar vol_outputs "[]")

;; Same row grammar as the Wi-Fi and Bluetooth lists — a 23pt leading circle
;; that fills with the accent on the output in use, then the name. No scroll: a
;; machine has a handful of sinks, not fifty networks, so the list is its own
;; height and the panel grows with it.
(defwidget vol-outputs []
  (box :orientation "vertical" :space-evenly false
       :visible {arraylength(vol_outputs) > 0}
    (box :class "sep out-sep")
    (label :class "menu-section" :text "Output" :halign "start")
    (box :orientation "vertical" :space-evenly false
      (for o in vol_outputs
        ;; Clicking leaves the menu open, like Bluetooth and unlike Wi-Fi: the
        ;; tick moving to the row you pressed is the confirmation, and that is
        ;; worth staying to watch.
        (button :class "row" :onclick "eww-state volume output ${o.id_b64}"
          (box :space-evenly false :spacing 8 :valign "center"
            (box :class "row-mark disc ${o.active ? 'on' : 'off'}" :valign "center"
                 :halign "center"
              (box :class "row-glyph" :halign "center" :valign "center"
                   :style "background-image: url('${o.icon}');"))
            (label :class "row-name" :text {o.name} :halign "start" :hexpand true
                   :limit-width 26 :show-truncated true)))))))

(defwidget vol-slider []
  (slider-panel :title "Volume" :icon vol_icon :value vol_pct
                :onchange "eww-state volume set {}"
    (vol-outputs)))

(defwidget bri-slider []
  (slider-panel :title "Display" :icon bri_icon :value bri_pct
                :onchange "eww-state brightness set {}"))

(defwindow volume-menu
  ;; 8 / 4 / 298 pt x 1.25. The Sound panel measures the same 298 wide as the
  ;; Wi-Fi and Bluetooth ones — panel edges at x 12 and 310 in sound-panel.png.
  :monitor 0 :geometry (geometry :anchor "top right" :x "10px" :y "5px" :width "373px")
  :stacking "overlay" :focusable false
  (vol-slider))

(defwindow brightness-menu
  ;; 8 / 4 / 298 pt x 1.25. The Sound panel measures the same 298 wide as the
  ;; Wi-Fi and Bluetooth ones — panel edges at x 12 and 310 in sound-panel.png.
  :monitor 0 :geometry (geometry :anchor "top right" :x "10px" :y "5px" :width "373px")
  :stacking "overlay" :focusable false
  (bri-slider))

;; `eww-state shot capture` (bound to Print) runs the region select and stages
;; the result, then opens this menu with Copy / Save / Discard. Its own open var
;; and backdrop, outside the `menu` group, since a keybind popup should neither
;; close nor be closed by a bar dropdown. The shot is a background-image box
;; sized by the daemon to the captured aspect ratio, so it clips to rounded
;; corners without distorting.
(defvar shot_path "")
(defvar shot_w 320)
(defvar shot_h 200)

(defwidget shot-panel []
  (box :class "menu shot ${theme}" :orientation "vertical" :space-evenly false :spacing 10
    (box :class "shot-preview" :halign "center"
         :style "background-image: url('${shot_path}'); min-width: ${shot_w}px; min-height: ${shot_h}px;")
    ;; `:show-truncated false` on every one of these. An eww label truncates by
    ;; default, which makes its minimum width a single character and an ellipsis
    ;; — so a narrow card does not grow to fit its buttons, it shrinks them, and
    ;; a small region gave three buttons reading "C…", "Sa…" and "Di…". Saying
    ;; the labels may not be cut is what puts the card's minimum width back
    ;; under the control of what is written on them.
    (box :class "shot-actions" :space-evenly true :spacing 8
      (button :class "shot-btn" :onclick "eww-state shot copy"
        (label :show-truncated false :text "Copy"))
      (button :class "shot-btn" :onclick "eww-state shot save"
        (label :show-truncated false :text "Save"))
      (button :class "shot-btn" :onclick "eww-state shot discard"
        (label :show-truncated false :text "Discard")))))

(defwindow shot-menu
  :monitor 0
  :geometry (geometry :anchor "top right" :x "10px" :y "5px")   ;; 8 / 4 pt x 1.25
  :stacking "overlay"
  :focusable false
  (shot-panel))

;; Its own click-catcher, not the shared `menu-backdrop`, so a click outside
;; dismisses only the shot and leaves any bar menu alone.
(defwindow shot-backdrop
  :monitor 0
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  :stacking "overlay"
  :focusable false
  :namespace "eww-backdrop"
  (button :class "backdrop" :onclick "eww-state shot close"
          :hexpand true :vexpand true))

;; :exclusive true reserves the 24px strip so windows sit below the bar rather
;; than under it. Whether it is shown at all is the daemon's call: it watches the
;; compositor and hides bar and dock together on a fullscreen Space.
(defwindow bar
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "100%"
                      :height "30px" :anchor "top center")   ;; 24pt x 1.25
  :stacking "overlay"
  :exclusive true
  :focusable false
  ;; See the dock: its own namespace so the slide rule can name it.
  :namespace "eww-bar"
  (bar))

;; The launcher, on SUPER + Space. Its own window and its own backdrop, outside
;; the `menu` group for the same reason the screenshot preview is: a keybind
;; popup should neither dismiss a bar dropdown nor be dismissed by one.
;;
;; The text lives in this entry rather than in the daemon. A round trip from a
;; keystroke to a published var and back is about 30ms, so a daemon-owned buffer
;; would draw the letters behind the typing, and an echo landing after the next
;; keystroke would delete it. What the daemon owns is the ranking, the
;; highlight, and whether this window is open at all.
(defvar search_hits "[]")
(defvar search_h 0)
(defvar search_none false)

;; The two handlers that carry typed text, and the reason they look like this.
;;
;; eww substitutes `{}` by plain textual replacement — `cmd.replace("{}", value)`
;; in crates/eww/src/widgets/mod.rs — and then hands the result to `/bin/sh -c`.
;; Nothing is quoted anywhere on that path, so whatever is typed here is a shell
;; command line: an apostrophe in "don't" ends an argument, and `$(…)` or a
;; backtick runs. A quoted heredoc is what makes it inert — inside `<<'EWWQ'`
;; nothing expands at all — and `"$(cat …)"` puts the result back together as one
;; argument, spaces and all. The delimiter cannot collide with what is typed
;; because a GtkEntry holds no newlines.
;;
;; `<<'EWWQ'`, NOT `<<\EWWQ`: yuck eats the backslash while unescaping the
;; string, which turns it back into an expanding heredoc that runs what it is
;; given. Tested; do not "simplify" it.
;;
;; Return carries the text as well as changing it. eww runs each handler on a
;; thread of its own, so the change for the last letter typed and the Return
;; that follows it race; the text on the Return is what settles it.
(defwidget search-panel []
  (box :class "menu search ${theme}" :orientation "vertical" :space-evenly false
    (box :class "search-field"
      (input :class "search-input" :hexpand true
             :onchange "eww-state search query \"$(cat <<'EWWQ'
{}
EWWQ
)\""
             :onaccept "eww-state search accept \"$(cat <<'EWWQ'
{}
EWWQ
)\""))
    (box :class "sep" :visible {search_h > 0 || search_none})
    (box :class "search-list" :orientation "vertical" :space-evenly false
         :visible {search_h > 0}
      (for hit in search_hits
        ;; The command, not the row's position: the list can be rebuilt between
        ;; the frame the user saw and the click landing on it. Base64 for the
        ;; same reason an SSID is — this one goes through a shell too.
        (button :class {hit.sel ? "search-row sel" : "search-row"}
                :onclick "eww-state search launch ${hit.exec_b64}"
          (box :orientation "horizontal" :space-evenly false :spacing 12
            (box :class "search-icon" :valign "center"
                 :style "background-image: url('${hit.icon}');")
            (label :class "search-name" :halign "start" :show-truncated false
                   :text {hit.name})))))
    (box :class "search-list" :visible search_none
      (label :class "search-empty" :text "No Results"))))

;; :focusable true is what gives the entry a keyboard at all — it sets the layer
;; surface's keyboard interactivity, and without it the field can never be typed
;; into. The compositor still sees every key first, which is how the submap in
;; hyprland.lua takes Escape and the arrows while letters carry on reaching here.
(defwindow search
  :monitor 0
  ;; Anchored to the top, not centred, and that is the whole reason the field
  ;; holds still. A centred window grows in both directions as results arrive,
  ;; so the entry slid up the screen by ~186px between an empty list and a full
  ;; one and the text you were typing moved out from under the cursor. Anchored
  ;; here the top edge is fixed and the list grows downward off it.
  ;;
  ;; 330px puts the field where the centred panel used to sit with about four
  ;; results — the common case — so the usual view is unchanged.
  :geometry (geometry :anchor "top center" :x "0px" :y "330px" :width "640px")
  :stacking "overlay"
  :focusable true
  :namespace "eww-search"
  (search-panel))

;; Its own click-catcher, so a click outside the launcher leaves any bar
;; dropdown and any screenshot preview alone.
(defwindow search-backdrop
  :monitor 0
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  :stacking "overlay"
  :focusable false
  :namespace "eww-backdrop"
  (button :class "backdrop" :onclick "eww-state search close"
          :hexpand true :vexpand true))
