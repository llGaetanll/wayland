;; The dock's apps, in order, each with whether it currently has a window.
(defvar dock_apps "[]")

;; One dock slot: the eventbox makes it both draggable and a drop target, so
;; dropping app {} here swaps the two. A plain click falls through to the button.
(defwidget applaunch [id icon]
  (eventbox :class "dock-slot" :dragvalue id :dragtype "values"
            :ondropped "eww-state dock swap {} ${id}"
    ;; No `setsid -f` needed: every handler is one connect-write-read on a unix
    ;; socket, well under eww's 200ms :timeout.
    (button :class "dock-btn" :onclick "eww-state dock launch ${id}"
      ;; Fixed-size cell, so nothing a tile does can move its neighbours.
      (box :class "dock-cell" :halign "center" :valign "center"
        (box :class "dock-icon" :halign "center" :valign "center"
             :style "background-image: url('${icon}');")))))

;; Windows put away in the dock. macOS keeps these past the separator in the order
;; they were minimized, and draws the window itself with the app icon badged on
;; the corner. The daemon photographs a window on its way out, which is the only
;; moment there is anything left to photograph.
(defvar dock_minimized "[]")

(defwidget minimized [addr thumb icon title width]
  ;; The one window command that names a window: a minimized one can never be
  ;; the focused one.
  (button :class "dock-btn" :tooltip title
          :onclick "eww-state window restore ${addr}"
    ;; Sized by the daemon: a tile is as wide as the window was, and GTK sizes a
    ;; box long before it knows anything about the image going into it.
    (box :class "dock-cell" :halign "center" :valign "center"
         :style "min-width: ${width}px;"
      (box :class "dock-thumb" :halign "center" :valign "center"
           :style "background-image: url('${thumb}'); min-width: ${width}px;"
        (box :class "dock-badge" :halign "end" :valign "end"
             :style "background-image: url('${icon}');")))))

(defwidget dock []
  ;; The `for` lives in its own box on purpose: eww appends what a `for` produces
  ;; AFTER its written siblings, which put the separator in front of every app.
  ;; Static children keep the order they are written in.
  (box :class "dock ${theme}" :space-evenly false :valign "center" :spacing 0
    (box :class "dock-apps" :space-evenly false :spacing 0
      (for a in {dock_apps}
        (applaunch :id {a.id} :icon {a.icon})))
    ;; With no window put away this is the dock's last child, a hairline hanging
    ;; off the end of the apps.
    (box :class "dock-sep" :valign "center" :vexpand false
         :visible {arraylength(dock_minimized) > 0})
    ;; Its own box for the same reason the app loop has one.
    (box :class "dock-minimized" :space-evenly false :spacing 0
      (for m in {dock_minimized}
        (minimized :addr {m.addr} :thumb {m.thumb} :icon {m.icon}
                   :title {m.title} :width {m.width})))))

(defwindow dock
  :monitor 0
  ;; A measured 5pt of desktop below the slab, x 1.25 scale. eww resolves
  ;; defwindow geometry statically (a variable is "Unknown variable" at open
  ;; time), so this is a literal. KEEP IN SYNC with $ui-scale in metrics.scss.
  :geometry (geometry :y "6px" :anchor "bottom center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  ;; Its own namespace so the Hyprland slide rule reaches the dock without also
  ;; catching the menus, which share the default gtk-layer-shell one.
  ;; KEEP IN SYNC with the layer rules in ~/.config/hypr/hyprland.lua.
  :namespace "eww-dock"
  (dock))

;; The same dock dropped until only its top edge shows, for when the windows
;; below are tiled and it would otherwise sit on top of one. eww-state opens this
;; or the plain dock, never both.
;; -55px = 10 - 65: the slab is 65px tall ($dock-tile 44 + 4px padding each side,
;; x 1.25) and 10px stays on screen, putting its top edge halfway between a tiled
;; window's bottom and the screen's. The 10 is the half-gap and does not move.
;; KEEP IN SYNC with $dock-tile in theme/metrics.scss, and with general:gaps_out
;; (20) and general:border_size (1) in ~/.config/hypr/config/options.lua, which
;; are what put a tiled window's bottom edge 21px up.
(defwindow dock-low
  :monitor 0
  :geometry (geometry :y "-55px" :anchor "bottom center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  ;; Its own namespace, not the dock's: the Hyprland rules have to tell the two
  ;; apart, or swapping them plays a slide out and in at once and reads as a bounce.
  :namespace "eww-dock-low"
  (dock))
