;; `eww-state shot capture` (bound to Print) runs the region select, stages the
;; result, and opens this menu. Its own backdrop, outside the `menu` group, since a
;; keybind popup should neither close nor be closed by a bar dropdown. The shot is
;; a background-image box sized by the daemon to the captured aspect ratio.
(defvar shot_path "")
(defvar shot_w 320)
(defvar shot_h 200)

(defwidget shot-panel []
  (box :class "menu shot ${theme}" :orientation "vertical" :space-evenly false :spacing 10
    (box :class "shot-preview" :halign "center"
         :style "background-image: url('${shot_path}'); min-width: ${shot_w}px; min-height: ${shot_h}px;")
    ;; `:show-truncated false` on every one: an eww label truncates by default,
    ;; making its minimum width one character and an ellipsis, so a small region
    ;; gave three buttons reading "C…", "Sa…" and "Di…".
    (box :class "shot-actions" :space-evenly true :spacing 8
      (button :class "shot-btn" :onclick "eww-state shot copy"
        (label :show-truncated false :text "Copy"))
      (button :class "shot-btn" :onclick "eww-state shot save"
        (label :show-truncated false :text "Save"))
      (button :class "shot-btn" :onclick "eww-state shot discard"
        (label :show-truncated false :text "Discard")))))

(defwindow shot-menu
  :monitor 0
  :geometry (geometry :anchor "top right" :x "10px" :y "5px")   ;; 8 / 4 pt x 1.25
  :stacking "overlay"
  :focusable false
  (shot-panel))

;; Its own click-catcher, so a click outside leaves any bar menu alone.
(defwindow shot-backdrop
  :monitor 0
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  :stacking "overlay"
  :focusable false
  :namespace "eww-backdrop"
  (button :class "backdrop" :onclick "eww-state shot close"
          :hexpand true :vexpand true))
