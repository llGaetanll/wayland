;; The launcher, on SUPER + Space. Its own window and backdrop, outside the `menu`
;; group: a keybind popup should neither dismiss a bar dropdown nor be dismissed
;; by one.
;;
;; The text lives in this entry, not in the daemon: a keystroke-to-published-var
;; round trip is ~30ms, so a daemon-owned buffer would draw the letters behind the
;; typing. The daemon owns the ranking, the highlight, and whether this is open.
(defvar search_hits "[]")
(defvar search_h 0)
(defvar search_none false)
(defvar search_empty true)

;; The two handlers that carry typed text, and why they look like this.
;;
;; eww substitutes `{}` by plain textual replacement and hands the result to
;; `/bin/sh -c`, quoting nothing — so typed text is a shell command line, where an
;; apostrophe ends an argument and `$(…)` runs. The quoted heredoc makes it inert,
;; and `"$(cat …)"` puts it back together as one argument. The delimiter cannot
;; collide with the text because a GtkEntry holds no newlines.
;;
;; `<<'EWWQ'`, NOT `<<\EWWQ`: yuck eats the backslash while unescaping, turning it
;; back into an expanding heredoc that runs what it is given. Do not "simplify".
;;
;; Return carries the text as well as changing it: eww runs each handler on its own
;; thread, so the last letter's change and the Return race, and the Return settles it.
(defwidget search-panel []
  (box :class "menu search ${theme}" :orientation "vertical" :space-evenly false
    ;; eww's `input` has no placeholder property, so the prompt is a dimmed label
    ;; over the empty field. The entry is the overlay's first child and so decides
    ;; the size; a label has no window of its own, so clicks pass through it.
    ;; It hides on `search_empty`, the daemon's word, which arrives a round trip
    ;; later — for ~30ms the first character is drawn over the prompt.
    (box :class "search-field"
      (overlay
        (input :class "search-input" :hexpand true
             :onchange "eww-state search query \"$(cat <<'EWWQ'
{}
EWWQ
)\""
             :onaccept "eww-state search accept \"$(cat <<'EWWQ'
{}
EWWQ
)\"")
        (label :class "search-prompt" :text "System Search"
               :halign "start" :valign "center" :visible search_empty)))
    (box :class "sep" :visible {search_h > 0 || search_none})
    (box :class "search-list" :orientation "vertical" :space-evenly false
         :visible {search_h > 0}
      (for hit in search_hits
        ;; The command, not the row's position: the list can be rebuilt between
        ;; the frame seen and the click landing. Base64 because it hits a shell.
        (button :class {hit.sel ? "search-row sel" : "search-row"}
                :onclick "eww-state search launch ${hit.exec_b64}"
          (box :orientation "horizontal" :space-evenly false :spacing 12
            (box :class "search-icon" :valign "center"
                 :style "background-image: url('${hit.icon}');")
            (label :class "search-name" :halign "start" :show-truncated false
                   :text {hit.name})))))
    (box :class "search-list" :visible search_none
      (label :class "search-empty" :text "No Results"))))

;; :focusable true is what gives the entry a keyboard at all: it sets the layer
;; surface's keyboard interactivity. The compositor still sees every key first,
;; which is how the submap in hyprland.lua takes Escape and the arrows.
(defwindow search
  :monitor 0
  ;; Anchored to the top, not centred, so the field holds still: a centred window
  ;; grows both ways as results arrive and slid the entry ~186px up the screen.
  ;; 330px puts it where the centred panel sat at about four results.
  :geometry (geometry :anchor "top center" :x "0px" :y "330px" :width "640px")
  :stacking "overlay"
  :focusable true
  :namespace "eww-search"
  (search-panel))

;; Its own click-catcher, so a click outside the launcher leaves any bar
;; dropdown and any screenshot preview alone.
(defwindow search-backdrop
  :monitor 0
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  :stacking "overlay"
  :focusable false
  :namespace "eww-backdrop"
  (button :class "backdrop" :onclick "eww-state search close"
          :hexpand true :vexpand true))
