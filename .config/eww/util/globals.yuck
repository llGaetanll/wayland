;; How the daemon detects `eww reload`, which resets every defvar to the literal
;; here on the same process and socket, so the connection looks untouched. The
;; daemon stamps a number here and reads it back; a table without the current one
;; is republished from scratch. Leave it empty — the daemon never publishes "".
(defvar eww_gen "")

(defvar theme "light")

(defvar clock "")
