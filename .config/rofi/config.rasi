/*
 * rofi behaviour. See themes/spotlight.rasi for the look.
 *
 * NOTE: keep the configuration {} block below free of comments. rofi 2.0's
 * parser drops the property that immediately follows a multi-line comment
 * placed *inside* the block, so all documentation lives out here instead:
 *
 *   modes             -> drun (launch .desktop apps), run (raw binaries),
 *                        window (switch between open windows). Ctrl+Tab /
 *                        Shift+Right cycle between them (rofi 2.0 defaults).
 *   icon-theme        -> swap "Adwaita" for "WhiteSur" once that icon theme is
 *                        installed, to match the rest of the system.
 *   drun-match-fields -> match on more than the visible name, so fuzzy typing
 *                        finds apps by category/keyword (e.g. "browser").
 *   Escape cancels; both are rofi defaults so they need no binding here.
 */

configuration {
    modes: "drun,run,window";
    show-icons: true;
    icon-theme: "Adwaita";
    drun-display-format: "{name}";
    display-drun: "Search";
    display-run: "Run";
    display-window: "Windows";
    drun-match-fields: "name,generic,exec,categories,keywords";
}

@import "/home/al/.config/rofi/themes/spotlight.rasi"
