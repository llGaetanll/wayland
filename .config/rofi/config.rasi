/*
 * rofi behaviour. See themes/spotlight.rasi for the look.
 *
 * Keep the configuration block below free of comments: rofi 2.0's parser drops
 * the property immediately following a multi-line comment placed inside it, so
 * the notes live out here.
 *
 * icon-theme: swap Adwaita for WhiteSur once that icon theme is installed.
 * drun-match-fields matches more than the visible name, so fuzzy typing finds
 * apps by category or keyword.
 */

configuration {
    modes: "drun,run,window";
    show-icons: true;
    icon-theme: "Adwaita";
    drun-display-format: "{name}";
    display-drun: "Search";
    display-run: "Run";
    display-window: "Windows";
    drun-match-fields: "name,generic,exec,categories,keywords";
}

@import "/home/al/.config/rofi/themes/spotlight.rasi"
