/*
 * macOS menu-bar-dropdown theme for rofi, used by the Wi-Fi password prompt in
 * eww/scripts/wifi-action.sh. Unlike the centred spotlight.rasi this anchors
 * top-right under the top bar, so it reads as a submenu of the menu bar.
 */

* {
    /* palette, keep in sync with spotlight.rasi + eww/eww.scss */
    bg:      rgba(40, 40, 40, 0.85);   /* window fill */
    fg:      #ffffff;                  /* primary text */
    muted:   rgba(235, 235, 235, 0.55);/* header / secondary */
    sel:     rgba(255, 255, 255, 0.14);/* selected row */
    sep:     rgba(255, 255, 255, 0.08);/* divider under the header */

    background-color: transparent;
    text-color:       @fg;
}

window {
    /* Nudged down below the 24px top bar; x-offset trims it off the right edge
       so it sits under the status-icon cluster. */
    location:  northeast;
    anchor:    northeast;
    x-offset:  -6px;
    y-offset:  30px;
    width:     300px;

    background-color: @bg;
    border-radius:    12px;
    padding:          6px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  0;
    padding:  0;
}

/* The prompt acts as the title; the entry stays present so type-to-filter still
   works, but slim and subtle. */
inputbar {
    children: [ prompt, entry ];
    padding:  6px 10px 8px 10px;
    spacing:  8px;
    border:       0px 0px 1px 0px;   /* divider under the header */
    border-color: @sep;
}

prompt {
    font:        "Inter Semibold 13";
    text-color:  @fg;
    vertical-align: 0.5;
}

entry {
    font:              "Inter 12";
    text-color:        @fg;
    placeholder:       "";
    placeholder-color: @muted;
    cursor:            text;
    vertical-align:    0.5;
}

listview {
    dynamic:      true;
    fixed-height: false;
    lines:        9;
    columns:      1;
    scrollbar:    false;

    padding:  6px 0px 2px 0px;
    spacing:  1px;
}

element {
    children:      [ element-text ];
    padding:       7px 10px;
    spacing:       0;
    border-radius: 7px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @sel;
    text-color:       @fg;
}

element-text {
    font:            "Inter 13";
    vertical-align:  0.5;
    text-color:      inherit;
    background-color: transparent;
    /* rows carry pango markup (monospace signal bars); allow it. */
    markup:          true;
}
